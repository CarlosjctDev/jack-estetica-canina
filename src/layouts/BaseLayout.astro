---
import "../styles/global.css";
import { aperturaDetalle, aperturaEtiqueta, aperturaTitulo, brandName, disponibleDesde, disponibleDesdeLabel, proximamente, siteUrl } from "../data/site.ts";

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown>;
}

const { title, description, schema } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL("/og-image.png", siteUrl).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#dcebd8" />
    {proximamente && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${brandName} Estética Canina`} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${brandName} Estética Canina a domicilio`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {!proximamente && schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />}
  </head>
  <body class="min-h-screen bg-paper text-ink">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-gold focus:px-4 focus:py-2 focus:font-semibold focus:text-ink"
    >
      Saltar al contenido
    </a>
    {
      proximamente ? (
        <main id="contenido" tabindex="-1" class="relative flex min-h-screen items-center justify-center overflow-hidden bg-forest px-5 py-20 text-paper">
          <div class="snowfield absolute inset-0" aria-hidden="true"></div>
          <div class="relative w-full max-w-2xl text-center">
            <picture class="mx-auto block size-20 shrink-0 overflow-hidden rounded-full border border-gold/60 bg-cream shadow-[0_8px_20px_-10px_rgba(15,53,39,0.55)]">
              <img src="/logo-128.webp" srcset="/logo-128.webp 128w, /logo-640.webp 640w" sizes="80px" alt={`Logotipo de ${brandName} Estética Canina`} width="1600" height="1600" decoding="async" class="size-full scale-110 object-cover" />
            </picture>
            <p class="mt-8 inline-flex items-center rounded-full border border-gold/40 bg-gold/10 px-4 py-2 text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-gold">
              {aperturaEtiqueta}
            </p>
            <h1 class="display mt-5 text-[clamp(2.7rem,10vw,5.5rem)] leading-[0.9]">{aperturaTitulo}</h1>
            <p class="mx-auto mt-5 max-w-lg text-base leading-relaxed text-paper/80">
              {aperturaDetalle}
            </p>
            <div class="mt-9 rounded-3xl border border-gold/30 bg-cream/5 p-5 shadow-[0_30px_80px_-50px_rgba(0,0,0,0.8)] backdrop-blur-sm sm:p-7">
              <p class="eyebrow text-gold">Disponible a partir del</p>
              <time datetime={disponibleDesde} class="mt-2 block font-display text-2xl text-paper sm:text-3xl">
                {disponibleDesdeLabel}
              </time>
              <div
                data-countdown
                data-launch-date={disponibleDesde}
                role="timer"
                aria-live="off"
                aria-label="Tiempo restante para la apertura"
                class="mt-6 grid grid-cols-4 gap-2 sm:gap-4"
              >
                <div role="group" aria-label="Días restantes" class="rounded-2xl border border-paper/15 bg-forest/60 px-2 py-4">
                  <span data-countdown-days class="block font-display text-3xl tabular-nums text-gold sm:text-4xl">--</span>
                  <span class="mt-1 block text-[0.6rem] font-semibold uppercase tracking-[0.2em] text-paper/70">Días</span>
                </div>
                <div role="group" aria-label="Horas restantes" class="rounded-2xl border border-paper/15 bg-forest/60 px-2 py-4">
                  <span data-countdown-hours class="block font-display text-3xl tabular-nums text-gold sm:text-4xl">--</span>
                  <span class="mt-1 block text-[0.6rem] font-semibold uppercase tracking-[0.2em] text-paper/70">Horas</span>
                </div>
                <div role="group" aria-label="Minutos restantes" class="rounded-2xl border border-paper/15 bg-forest/60 px-2 py-4">
                  <span data-countdown-minutes class="block font-display text-3xl tabular-nums text-gold sm:text-4xl">--</span>
                  <span class="mt-1 block text-[0.6rem] font-semibold uppercase tracking-[0.2em] text-paper/70">Min</span>
                </div>
                <div role="group" aria-label="Segundos restantes" class="rounded-2xl border border-paper/15 bg-forest/60 px-2 py-4">
                  <span data-countdown-seconds class="block font-display text-3xl tabular-nums text-gold sm:text-4xl">--</span>
                  <span class="mt-1 block text-[0.6rem] font-semibold uppercase tracking-[0.2em] text-paper/70">Seg</span>
                </div>
              </div>
              <p data-countdown-status role="status" aria-live="polite" class="mt-4 text-xs text-paper/60">
                El contador se actualiza en tiempo real.
              </p>
            </div>
          </div>
        </main>
      ) : (
        <slot />
      )
    }
    <script>
      const countdown = document.querySelector<HTMLElement>("[data-countdown]");
      const daysNode = document.querySelector<HTMLElement>("[data-countdown-days]");
      const hoursNode = document.querySelector<HTMLElement>("[data-countdown-hours]");
      const minutesNode = document.querySelector<HTMLElement>("[data-countdown-minutes]");
      const secondsNode = document.querySelector<HTMLElement>("[data-countdown-seconds]");
      const statusNode = document.querySelector<HTMLElement>("[data-countdown-status]");

      if (countdown && daysNode && hoursNode && minutesNode && secondsNode && statusNode) {
        const target = new Date(countdown.dataset.launchDate ?? "").getTime();

        if (!Number.isNaN(target)) {
          let intervalId: number | undefined;

          const render = (days: number, hours: number, minutes: number, seconds: number) => {
            daysNode.textContent = String(days).padStart(2, "0");
            hoursNode.textContent = String(hours).padStart(2, "0");
            minutesNode.textContent = String(minutes).padStart(2, "0");
            secondsNode.textContent = String(seconds).padStart(2, "0");
          };

          const updateCountdown = () => {
            const remaining = target - Date.now();

            if (remaining <= 0) {
              render(0, 0, 0, 0);
              statusNode.textContent = "¡Ya estamos disponibles!";
              if (intervalId !== undefined) window.clearInterval(intervalId);
              return;
            }

            const days = Math.floor(remaining / 86_400_000);
            const hours = Math.floor((remaining % 86_400_000) / 3_600_000);
            const minutes = Math.floor((remaining % 3_600_000) / 60_000);
            const seconds = Math.floor((remaining % 60_000) / 1_000);
            render(days, hours, minutes, seconds);
          };

          updateCountdown();
          if (Date.now() < target) intervalId = window.setInterval(updateCountdown, 1_000);
        }
      }
    </script>
  </body>
</html>
