---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { brandName, groupDiscountNote, instagramLabel, instagramUrl, nearbyTownsNote, siteUrl, whatsappNumber, whatsappUrl } from "../data/site.ts";

const services = [
  {
    number: "01",
    tag: "Oídos",
    title: "Limpieza de oídos",
    description: "Limpieza suave de oídos con herramientas limpias y productos aptos para perros.",
    span: "md:col-span-2",
  },
  {
    number: "02",
    tag: "Uñas",
    title: "Corte de uñas",
    description: "Recorte de uñas con precisión para evitar molestias al caminar.",
    span: "md:col-span-2",
  },
  {
    number: "03",
    tag: "Pelaje",
    title: "Desenredar",
    description: "Desenredado cuidadoso del pelaje para evitar tirones y mantenerlo cómodo.",
    span: "md:col-span-2",
  },
  {
    number: "04",
    tag: "Baño",
    title: "Baño",
    description: "Limpieza profunda con productos aptos para perros, secado completo y atención a la piel y el pelaje.",
    span: "md:col-span-3",
  },
  {
    number: "05",
    tag: "Corte",
    title: "Corte de pelo",
    description: "Corte de pelo según la raza y el look que prefieras para tu perro.",
    span: "md:col-span-3",
  },
  {
    number: "06",
    tag: "Obsequio",
    title: "Detalle navideño",
    description: "Lazo, corbata o pañoleta de regalo con tu servicio, hasta agotar disponibilidad.",
    span: "md:col-span-6",
    highlight: true,
  },
];

const zones = [
  {
    label: "Zona 01",
    name: "Barranquilla",
    description: "Atención a domicilio en sectores de Barranquilla. Coordinamos la hora que mejor te quede.",
    tone: "bg-paper text-ink",
  },
  {
    label: "Zona 02",
    name: "Soledad",
    description: "También llegamos a Soledad con el mismo servicio, el mismo cuidado y sin desplazamientos.",
    tone: "border border-paper/25 text-paper",
  },
];

const steps = [
  {
    number: "01",
    title: "Escríbenos",
    description: "Envía un WhatsApp con el nombre de tu perro, la zona y el servicio que necesitas.",
  },
  {
    number: "02",
    title: "Coordinamos",
    description: "Definimos día, hora y dirección. Si hace falta, te pedimos una foto para llegar preparados.",
  },
  {
    number: "03",
    title: "Llegamos a ti",
    description: "Hacemos el servicio en tu casa, con calma, limpieza y respeto por los tiempos de tu mascota.",
  },
];

const pageDescription = `Estética canina a domicilio para perros medianos y pequeños en Barranquilla y Soledad. Limpieza de oídos, corte de uñas, desenredado, baño y corte de pelo. ${groupDiscountNote}, obsequio navideño hasta agotar disponibilidad y atención a consultas de pueblos cercanos.`;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "PetGroomer",
  name: `${brandName} Estética Canina`,
  description: pageDescription,
  url: `${siteUrl}/`,
  image: `${siteUrl}/og-image.png`,
  telephone: whatsappNumber,
  priceRange: "$$",
  areaServed: ["Barranquilla", "Soledad"],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Barranquilla",
    addressRegion: "Atlántico",
    addressCountry: "CO",
  },
  sameAs: [instagramUrl],
};
---

<BaseLayout title={`${brandName} — Estética canina a domicilio`} description={pageDescription} schema={localBusinessSchema}>
  <Header />

  <main id="contenido">
    <section id="inicio" class="snowfield-light relative overflow-hidden border-b border-forest/15 bg-mint">
      <div class="relative mx-auto grid max-w-7xl gap-16 px-5 pb-24 pt-16 sm:px-8 lg:min-h-[88vh] lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:pb-32 lg:pt-24">
        <div class="reveal">
          <p class="eyebrow flex items-center gap-4 text-holly">
            <span class="h-px w-12 bg-holly" aria-hidden="true"></span>
            Navidad · perros medianos y pequeños
          </p>

          <h1 class="mt-8 leading-[0.78]">
            <span class="brand-mark block text-[clamp(6rem,15vw,13rem)]">{brandName}<span class="text-holly">.</span></span>
            <span class="display-italic mt-1 block text-[0.34em] text-gold">a domicilio</span>
          </h1>

          <p class="mt-8 max-w-lg text-lg leading-relaxed text-ink/70">
            Tu perro, impecable. Sin salir de casa. Limpieza de oídos, corte de uñas, desenredado, baño y corte de pelo a domicilio en Barranquilla y Soledad. Esta Navidad, llevamos un obsequio hasta agotar disponibilidad.
          </p>
          <p class="mt-5 inline-flex items-center gap-2 rounded-full border border-gold/50 bg-cream/80 px-4 py-2 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-forest shadow-sm">
            <span class="size-1.5 rounded-full bg-holly" aria-hidden="true"></span>
            {groupDiscountNote}
          </p>
          <p class="mt-3 text-xs font-semibold uppercase tracking-[0.2em] text-forest">Perros medianos y pequeños · A domicilio</p>

          <div class="mt-10 flex flex-wrap items-center gap-4">
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-dark">
              Agendar por WhatsApp
              <span aria-hidden="true">→</span>
            </a>
            <a href="#servicios" class="btn-outline">
              Ver servicios
            </a>
          </div>

          <dl class="mt-16 grid max-w-lg grid-cols-3 gap-6 border-t border-ink/15 pt-6">
            <div>
              <dt class="stat-label">Servicio</dt>
              <dd class="display mt-2 text-2xl">Domicilio</dd>
            </div>
            <div>
              <dt class="stat-label">Zonas</dt>
              <dd class="display mt-2 text-2xl">2 ciudades</dd>
            </div>
            <div>
              <dt class="stat-label">Agenda</dt>
              <dd class="display mt-2 text-2xl">WhatsApp</dd>
            </div>
          </dl>
        </div>

        <div class="reveal reveal-2 relative">
          <div class="absolute -inset-4 -rotate-2 rounded-[2.5rem] border border-gold/40" aria-hidden="true"></div>

          <div class="image-frame rotate-1">
            <picture class="block overflow-hidden rounded-[1.5rem] bg-cream ring-1 ring-gold/30">
              <source type="image/avif" srcset="/logo-640.avif 640w, /logo.avif 1600w" sizes="(min-width: 1024px) 38vw, 90vw" />
              <img
                src="/logo-640.webp"
                srcset="/logo-640.webp 640w, /logo.webp 1600w"
                sizes="(min-width: 1024px) 38vw, 90vw"
                alt={`Logotipo de ${brandName} Estética Canina`}
                width="1600"
                height="1600"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="aspect-square w-full object-contain p-8"
              />
            </picture>
            <div class="flex items-center justify-between px-3 pb-2 pt-5">
              <p class="display text-2xl">Cuidado con carácter</p>
              <p class="stat-label">Edición navideña</p>
            </div>
          </div>

          <div class="absolute -left-8 -top-8 z-20 flex size-28 rotate-[-8deg] flex-col items-center justify-center rounded-full border border-gold/50 bg-cream text-center shadow-[0_20px_50px_-25px_rgba(15,53,39,0.5)] sm:-left-10 sm:-top-10 sm:size-32">
            <svg viewBox="0 0 24 24" class="size-5 text-holly" fill="currentColor" aria-hidden="true">
              <ellipse cx="12" cy="15" rx="5" ry="4" />
              <circle cx="6" cy="9" r="2" />
              <circle cx="10" cy="6" r="2" />
              <circle cx="14" cy="6" r="2" />
              <circle cx="18" cy="9" r="2" />
            </svg>
            <span class="mt-2 text-[0.58rem] font-semibold uppercase leading-tight tracking-[0.18em] text-ink/70">A domicilio</span>
          </div>
        </div>
      </div>
    </section>

    <div class="marquee overflow-hidden border-y border-paper/10 bg-forest py-4 text-paper/60" aria-hidden="true">
      <div class="marquee-track display text-2xl text-gold/80">
        <span>Limpieza de oídos · Corte de uñas · Desenredar · Baño · Corte de pelo · Obsequio navideño · {groupDiscountNote} · A domicilio · Barranquilla · Soledad · </span>
        <span>Limpieza de oídos · Corte de uñas · Desenredar · Baño · Corte de pelo · Obsequio navideño · {groupDiscountNote} · A domicilio · Barranquilla · Soledad · </span>
      </div>
    </div>

    <section id="servicios" class="snowfield-light mx-auto max-w-7xl px-5 py-28 sm:px-8 lg:py-40">
      <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
        <div>
          <p class="eyebrow text-holly">01 / Servicios</p>
          <h2 class="display mt-5 max-w-2xl text-6xl sm:text-7xl lg:text-8xl">El detalle hace la diferencia.</h2>
        </div>
        <p class="max-w-sm text-base leading-relaxed text-ink/65">
          Limpieza de oídos, corte de uñas, desenredado, baño y corte de pelo hechos con calma. Y de regalo, lazos, corbatas o pañoletas hasta agotar disponibilidad.
        </p>
      </div>

      <div class="mt-16 grid gap-px overflow-hidden rounded-3xl border border-ink/10 bg-ink/10 md:grid-cols-6">
        {
          services.map((service) => (
            <article
              class:list={[
                "group bg-cream p-9 transition-colors duration-500",
                service.span,
                service.highlight ? "bg-holly text-paper hover:bg-pine" : "hover:bg-paper",
              ]}
            >
              <div class="flex items-start justify-between">
                <span class="display text-6xl text-gold/70">{service.number}</span>
                <span class:list={["eyebrow", service.highlight ? "text-gold/80" : "text-muted"]}>{service.tag}</span>
              </div>
              <h3 class="display mt-10 text-4xl">{service.title}</h3>
              <p class:list={["mt-4 text-sm leading-relaxed", service.highlight ? "text-paper/75" : "text-ink/60"]}>{service.description}</p>
              <span class="mt-10 block h-px w-10 bg-gold transition-all duration-500 group-hover:w-full" aria-hidden="true"></span>
            </article>
          ))
        }
      </div>

      <p class="mt-8 text-sm text-ink/60">
        Atendemos perros medianos y pequeños. Si son 2+ perros en la misma zona, consulta nuestra tarifa preferencial por grupo. ¿No sabes qué necesita tu perro? Escríbenos y lo revisamos juntos por WhatsApp.
      </p>
    </section>

    <section id="zonas" class="snowfield relative overflow-hidden bg-forest text-paper">
      <div class="relative mx-auto max-w-7xl px-5 py-28 sm:px-8 lg:py-40">
        <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
          <div>
            <p class="eyebrow text-gold">02 / Cobertura</p>
            <h2 class="display mt-5 max-w-2xl text-6xl text-paper sm:text-7xl lg:text-8xl">Llegamos a tu puerta.</h2>
          </div>
          <p class="max-w-sm text-base leading-relaxed text-paper/55">
            Servicio a domicilio en Barranquilla y Soledad. Tú pones la dirección; nosotros ponemos todo lo demás.
          </p>
        </div>

        <div class="mt-16 grid gap-5 lg:grid-cols-2">
          {
            zones.map((zone) => (
              <article class:list={["relative overflow-hidden rounded-3xl p-6 sm:p-12", zone.tone]}>
                <div class="flex items-start justify-between">
                  <span class="eyebrow text-gold">{zone.label}</span>
                  <span class="eyebrow opacity-50">A domicilio</span>
                </div>
                <p class="display mt-20 text-[clamp(2rem,10vw,4.5rem)] sm:text-7xl">{zone.name}</p>
                <p class="mt-5 max-w-sm text-sm leading-relaxed opacity-65">{zone.description}</p>
                <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-outline mt-10">
                  Agendar en {zone.name}
                </a>
                <span class="display pointer-events-none absolute -bottom-10 right-4 text-[12rem] opacity-5" aria-hidden="true">
                  {zone.label.slice(-2)}
                </span>
              </article>
            ))
          }
        </div>

        <p class="mt-8 flex items-center gap-3 rounded-2xl border border-paper/15 bg-paper/5 px-6 py-5 text-sm leading-relaxed text-paper/70">
          <span class="size-2 shrink-0 rounded-full bg-gold" aria-hidden="true"></span>
          {nearbyTownsNote}
        </p>
      </div>
    </section>

    <section id="filosofia" class="snowfield-light mx-auto max-w-7xl px-5 py-28 sm:px-8 lg:py-40">
      <div class="grid gap-16 lg:grid-cols-[0.75fr_1.25fr]">
        <div>
          <p class="eyebrow text-holly">03 / Filosofía</p>
          <h2 class="display mt-5 text-6xl sm:text-7xl">Trato, calma y confianza.</h2>
          <div class="mt-10 h-px w-24 bg-gold" aria-hidden="true"></div>
        </div>

        <article class="prose prose-lg max-w-none font-sans prose-headings:font-display prose-headings:font-medium prose-headings:text-ink prose-p:font-sans prose-p:text-ink/70 prose-strong:text-ink prose-a:text-holly prose-blockquote:border-l-holly prose-blockquote:font-display prose-blockquote:text-2xl prose-blockquote:not-italic prose-blockquote:text-forest prose-li:marker:text-holly">
          <p class="lead">Sabemos que no todos los perros disfrutan salir. Por eso el servicio llega hasta tu puerta, sin traslados, esperas ni lugares extraños.</p>

          <h3>Un servicio con sentido</h3>
          <p>
            Cada perro tiene su ritmo. Por eso escuchamos primero, observamos después y avanzamos con <strong>paciencia</strong>. El objetivo no es solo que se vea bien, sino que termine la experiencia tranquilo.
          </p>

          <blockquote>El cuidado también es respetar los tiempos y el espacio de tu mascota.</blockquote>

          <p>
            Trabajamos con productos aptos para perros, herramientas limpias y atención al detalle. Si es la primera vez o tu perro es nervioso, lo tomamos con calma y ajustamos el proceso a su necesidad. Puedes conocer el paso a paso en <a href="#como-funciona">nuestro proceso</a>.
          </p>
        </article>
      </div>
    </section>

    <section id="como-funciona" class="snowfield-light border-y border-forest/15 bg-mint/60">
      <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:py-32">
        <p class="eyebrow text-holly">04 / Proceso</p>
        <h2 class="display mt-5 text-5xl sm:text-6xl">Así de sencillo.</h2>

        <div class="relative mt-16 grid gap-12 md:grid-cols-3 md:gap-8">
          <div class="absolute left-0 right-0 top-1 hidden h-px bg-ink/10 md:block" aria-hidden="true"></div>
          {
            steps.map((step) => (
              <article class="relative">
                <span class="relative z-10 block size-2 rounded-full bg-gold ring-4 ring-cream" aria-hidden="true"></span>
                <span class="display mt-8 block text-5xl text-gold/60">{step.number}</span>
                <h3 class="mt-4 font-display text-3xl font-medium">{step.title}</h3>
                <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink/60">{step.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="instagram" class="snowfield-light border-y border-forest/15 bg-cream">
      <div class="mx-auto max-w-7xl px-5 py-24 sm:px-8 lg:py-32">
        <div class="grid gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div>
            <p class="eyebrow text-holly">05 / Instagram</p>
            <h2 class="display mt-5 max-w-xl text-5xl sm:text-6xl">Tu perro, en nuestra historia.</h2>
            <p class="mt-6 max-w-xl text-base leading-relaxed text-ink/65">
              Estamos comenzando y queremos crecer contigo. Síguenos en {instagramLabel}, comparte el resultado y etiquétanos: tus fotos se convierten en nuestras mejores referencias.
            </p>
            <div class="mt-9">
              <a href={instagramUrl} target="_blank" rel="me noopener noreferrer" class="btn-dark">
                Seguir en Instagram
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <div class="relative">
            <div class="absolute -inset-4 rotate-2 rounded-[2.5rem] border border-gold/30" aria-hidden="true"></div>
            <div class="image-frame -rotate-1">
              <div class="rounded-[1.5rem] bg-forest p-8 text-paper sm:p-10">
                <svg viewBox="0 0 24 24" class="size-10 text-gold" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
                <p class="display mt-10 text-4xl sm:text-5xl">{instagramLabel}</p>
                <p class="mt-4 max-w-xs text-sm leading-relaxed text-paper/60">
                  Resultados reales, consejos de cuidado y novedades de {brandName}.
                </p>
                <p class="mt-10 border-t border-paper/15 pt-5 text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-gold">
                  Etiquétanos y suma tu historia
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="contacto" class="snowfield relative overflow-hidden bg-forest text-paper">
      <div class="relative mx-auto max-w-7xl px-5 py-28 sm:px-8 lg:py-40">
        <p class="eyebrow text-gold">06 / Agenda</p>
        <h2 class="display mt-6 text-[clamp(4rem,11vw,9rem)] leading-[0.84]">
          Agenda<br />su baño<span class="text-holly">.</span>
        </h2>

        <div class="mt-14 flex flex-col gap-8 border-t border-paper/15 pt-8 md:flex-row md:items-end md:justify-between">
          <p class="max-w-md text-lg leading-relaxed text-paper/60">
            Perros medianos y pequeños. Escríbenos por WhatsApp y coordinamos día, hora y dirección en Barranquilla o Soledad. Si son 2+ perros en la misma zona, consulta nuestra tarifa preferencial. {nearbyTownsNote} Consulta también la disponibilidad de tu obsequio navideño.
          </p>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-whatsapp">
            Agendar cita
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <p class="mt-10 text-xs font-semibold uppercase tracking-[0.24em] text-gold">{whatsappNumber}</p>
      </div>
    </section>
  </main>

  <Footer />

  <div class="fixed bottom-5 right-5 z-50 flex flex-col items-end gap-3">
    <a
      href={instagramUrl}
      target="_blank"
      rel="me noopener noreferrer"
      aria-label={`Ver ${brandName} en Instagram`}
      class="inline-flex items-center gap-2 rounded-full border border-gold/50 bg-forest/95 px-4 py-3 text-[0.62rem] font-semibold uppercase tracking-[0.18em] text-paper shadow-[0_18px_45px_-18px_rgba(0,0,0,0.6)] backdrop-blur transition-transform duration-300 hover:-translate-y-1"
    >
      <svg viewBox="0 0 24 24" class="size-4 text-gold" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
      </svg>
      Instagram
    </a>
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Agendar cita por WhatsApp"
      class="inline-flex items-center gap-2 rounded-full bg-[#25D366] px-5 py-4 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-ink shadow-[0_18px_45px_-18px_rgba(0,0,0,0.6)] transition-transform duration-300 hover:-translate-y-1"
    >
      <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
        <path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.2 1.1L6.6 10.8Z" />
      </svg>
      Agendar
    </a>
  </div>
</BaseLayout>
